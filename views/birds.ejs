<div class="section-header">
    <h2>Learn Birds</h2>
    <p>Discover colorful birds from around the world!</p>
</div>

<div class="birds-grid">
    <div class="bird-card" role="button" tabindex="0" aria-label="Parrot, squawk">
        <div class="bird-image" id="parrot"></div>
        <div class="bird-name">Parrot</div>
        <div class="bird-sound">Squawk</div>
    </div>
    <div class="bird-card" role="button" tabindex="0" aria-label="Peacock, call">
        <div class="bird-image" id="peacock"></div>
        <div class="bird-name">Peacock</div>
        <div class="bird-sound">Call</div>
    </div>
    <div class="bird-card" role="button" tabindex="0" aria-label="Eagle, screech">
        <div class="bird-image" id="eagle"></div>
        <div class="bird-name">Eagle</div>
        <div class="bird-sound">Screech</div>
    </div>
    <div class="bird-card" role="button" tabindex="0" aria-label="Sparrow, chirp">
        <div class="bird-image" id="sparrow"></div>
        <div class="bird-name">Sparrow</div>
        <div class="bird-sound">Chirp</div>
    </div>
    <div class="bird-card" role="button" tabindex="0" aria-label="Owl, hoot">
        <div class="bird-image" id="owl"></div>
        <div class="bird-name">Owl</div>
        <div class="bird-sound">Hoot</div>
    </div>
    <div class="bird-card" role="button" tabindex="0" aria-label="Flamingo, honk">
        <div class="bird-image" id="flamingo"></div>
        <div class="bird-name">Flamingo</div>
        <div class="bird-sound">Honk</div>
    </div>
    <div class="bird-card" role="button" tabindex="0" aria-label="Penguin, bray">
        <div class="bird-image" id="penguin-bird"></div>
        <div class="bird-name">Penguin</div>
        <div class="bird-sound">Bray</div>
    </div>
    <div class="bird-card" role="button" tabindex="0" aria-label="Hummingbird, chirp">
        <div class="bird-image" id="hummingbird"></div>
        <div class="bird-name">Hummingbird</div>
        <div class="bird-sound">Chirp</div>
    </div>
</div>

<div class="learning-tips">
    <h3>Learning Tips</h3>
    <ul>
        <li>Click each bird to hear its name and call</li>
        <li>Notice the different colors and beaks</li>
        <li>Talk about where each bird might live</li>
    </ul>
</div>
